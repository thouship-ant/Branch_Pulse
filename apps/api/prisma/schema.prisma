// Branch Pulse - schema implementing LLD sections 2-6.
//
// Conventions (LLD s1):
//  - snake_case columns, plural snake_case tables (via @@map); UUID v7 primary keys.
//  - Money NUMERIC(14,2), quantity NUMERIC(14,3), rate NUMERIC(14,4), percent NUMERIC(7,3).
//  - Relations are declared only for parent -> child aggregates (nested writes / includes).
//    All other foreign keys (location_id, user columns, item_id, supplier_id ...) are added as real
//    FK constraints in migration 20260926000200_constraints_rls_triggers.
//  - LLD "GENERATED ALWAYS" columns (mismatch_amount, variance, credit_amount, payable,
//    remaining_amount, variance_qty) are ordinary columns here, computed by the domain services
//    (the LLD requires all calculations to be server-side decimal arithmetic anyway).
//  - Audit columns (created_at/by, updated_at/by, version) are repeated on every mutable table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums
enum RecordStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  REVERSED

  @@map("record_status")
}

enum LocationType {
  BRANCH
  GODOWN
  CENTRAL_OFFICE

  @@map("location_type")
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

enum PaymentMode {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  CREDIT

  @@map("payment_mode")
}

enum EntrySource {
  WEB
  PWA_OFFLINE
  SYSTEM

  @@map("entry_source")
}

enum ClosingStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REOPENED

  @@map("closing_status")
}

enum CashTxnType {
  OPENING
  OTHER_RECEIPT
  WITHDRAWAL
  DEPOSIT_TO_BANK
  EXPENSE
  PURCHASE
  SUPPLIER_PAYMENT
  ADVANCE_PAYMENT
  ADJUSTMENT

  @@map("cash_txn_type")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HALF_DAY
  WEEK_OFF
  HOLIDAY

  @@map("attendance_status")
}

enum StockTxnType {
  OPENING
  PURCHASE_IN
  TRANSFER_OUT
  TRANSFER_IN
  CONSUMPTION
  WASTAGE
  COUNT_ADJUSTMENT
  TRANSFER_VARIANCE
  REVERSAL

  @@map("stock_txn_type")
}

enum TransferStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  DISPATCHED
  RECEIVED
  PARTIALLY_RECEIVED
  CANCELLED

  @@map("transfer_status")
}

enum CountStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED

  @@map("count_status")
}

enum WastageReason {
  SPOILED
  EXPIRED
  BURNT
  DAMAGED
  EXCESS_PREPARATION
  STAFF_CONSUMPTION
  COMPLIMENTARY
  OTHER

  @@map("wastage_reason")
}

enum AdvanceStatus {
  REQUESTED
  MANAGER_APPROVED
  APPROVED
  REJECTED
  PAID
  CLOSED
  CANCELLED

  @@map("advance_status")
}

enum AlertSeverity {
  CRITICAL
  WARNING
  INFO

  @@map("alert_severity")
}

// ---------------------------------------------------------------- access
// ---------------------------------------------------------------- tenancy
// One row per customer company. Every company-owned table carries company_id (defaulted from the session variable
// app.company_id that PrismaService.runScoped sets) and row-level security keeps companies apart.
model Company {
  id         String       @id @default(uuid(7)) @db.Uuid
  code       String       @unique @db.VarChar(12)
  name       String       @db.VarChar(120)
  address    String? // main shop / head office
  gstin      String?      @db.VarChar(15)
  fssai      String?      @db.VarChar(14)
  email      String?      @db.VarChar(120)
  status     RecordStatus @default(ACTIVE)
  created_at DateTime     @default(now()) @db.Timestamptz
  created_by String?      @db.Uuid
  updated_at DateTime     @updatedAt @db.Timestamptz
  updated_by String?      @db.Uuid
  version    Int          @default(1)

  @@map("companies")
}

/// One-time passwords for mobile sign-in. password_ok marks an Admin who already passed the password step.
model OtpCode {
  id          String    @id @default(uuid(7)) @db.Uuid
  mobile      String    @db.VarChar(15)
  code_hash   String
  password_ok Boolean   @default(false)
  attempts    Int       @default(0) @db.SmallInt
  expires_at  DateTime  @db.Timestamptz
  consumed_at DateTime? @db.Timestamptz
  ip          String?   @db.Inet
  created_at  DateTime  @default(now()) @db.Timestamptz

  @@index([mobile, created_at(sort: Desc)])
  @@map("otp_codes")
}

model Role {
  id         String       @id @default(uuid(7)) @db.Uuid
  company_id String?      @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  code       String       @db.VarChar(30)
  name       String       @db.VarChar(60)
  is_system  Boolean      @default(false)
  scope_mode String       @db.VarChar(10) // ALL | ASSIGNED (CHECK in migration)
  status     RecordStatus @default(ACTIVE)
  created_at DateTime     @default(now()) @db.Timestamptz
  created_by String?      @db.Uuid
  updated_at DateTime     @updatedAt @db.Timestamptz
  updated_by String?      @db.Uuid
  version    Int          @default(1)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  code        String  @unique @db.VarChar(60) // e.g. expense:create
  module      String  @db.VarChar(30)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       String @db.Uuid
  permission_id String @db.Uuid

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id                 String       @id @default(uuid(7)) @db.Uuid
  company_id         String?      @db.Uuid
  username           String       @unique @db.VarChar(50)
  mobile             String?      @unique @db.VarChar(15)
  email              String?      @db.VarChar(120)
  full_name          String       @db.VarChar(100)
  password_hash      String
  preferred_language String       @default("en") @db.Char(2)
  employee_id        String?      @db.Uuid
  mfa_enabled        Boolean      @default(false)
  failed_logins      Int          @default(0) @db.SmallInt
  locked_until       DateTime?    @db.Timestamptz
  last_login_at      DateTime?    @db.Timestamptz
  status             RecordStatus @default(ACTIVE)
  created_at         DateTime     @default(now()) @db.Timestamptz
  created_by         String?      @db.Uuid
  updated_at         DateTime     @updatedAt @db.Timestamptz
  updated_by         String?      @db.Uuid
  version            Int          @default(1)

  roles     UserRole[]
  locations UserLocation[]
  sessions  Session[]

  @@map("users")
}

model UserRole {
  user_id String @db.Uuid
  role_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
  @@map("user_roles")
}

model UserLocation {
  user_id     String @db.Uuid
  location_id String @db.Uuid

  user User @relation(fields: [user_id], references: [id])

  @@id([user_id, location_id])
  @@map("user_locations")
}

model Session {
  id                 String    @id @default(uuid(7)) @db.Uuid
  user_id            String    @db.Uuid
  refresh_token_hash String
  device_label       String?   @db.VarChar(100)
  user_agent         String?
  ip                 String?   @db.Inet
  created_at         DateTime  @default(now()) @db.Timestamptz
  expires_at         DateTime  @db.Timestamptz
  revoked_at         DateTime? @db.Timestamptz

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@map("sessions")
}

model ApprovalLimit {
  id          String   @id @default(uuid(7)) @db.Uuid
  company_id  String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  role_id     String   @db.Uuid
  entity_type String   @db.VarChar(30) // EXPENSE, PURCHASE, ADVANCE, WASTAGE, CASH_VARIANCE
  max_amount  Decimal  @db.Decimal(14, 2)
  created_at  DateTime @default(now()) @db.Timestamptz
  created_by  String?  @db.Uuid
  updated_at  DateTime @updatedAt @db.Timestamptz
  updated_by  String?  @db.Uuid
  version     Int      @default(1)

  @@unique([company_id, role_id, entity_type])
  @@map("approval_limits")
}

// ---------------------------------------------------------------- master data
model Location {
  id                   String       @id @default(uuid(7)) @db.Uuid
  company_id           String       @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  code                 String       @db.VarChar(10)
  name                 String       @db.VarChar(100)
  name_ta              String?      @db.VarChar(100)
  type                 LocationType
  address              String?
  phone                String?      @db.VarChar(15)
  manager_user_id      String?      @db.Uuid
  default_opening_cash Decimal      @default(0) @db.Decimal(14, 2)
  card_enabled         Boolean      @default(true)
  opened_on            DateTime?    @db.Date
  monthly_rent         Decimal?     @db.Decimal(14, 2)
  notes                String?
  status               RecordStatus @default(ACTIVE)
  created_at           DateTime     @default(now()) @db.Timestamptz
  created_by           String?      @db.Uuid
  updated_at           DateTime     @updatedAt @db.Timestamptz
  updated_by           String?      @db.Uuid
  version              Int          @default(1)

  @@map("locations")
}

model ExpenseCategory {
  id                     String       @id @default(uuid(7)) @db.Uuid
  company_id             String       @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  parent_id              String?      @db.Uuid
  name_en                String       @db.VarChar(60)
  name_ta                String?      @db.VarChar(60)
  pl_bucket              String       @db.VarChar(20) // RAW_MATERIAL|SALARY|RENT|ELECTRICITY|TRANSPORT|MAINTENANCE|OTHER|NON_PL
  requires_receipt_above Decimal?     @db.Decimal(14, 2)
  unusual_threshold      Decimal?     @db.Decimal(14, 2)
  requires_supplier      Boolean      @default(false)
  sort_order             Int          @default(0) @db.SmallInt
  status                 RecordStatus @default(ACTIVE)
  created_at             DateTime     @default(now()) @db.Timestamptz
  created_by             String?      @db.Uuid
  updated_at             DateTime     @updatedAt @db.Timestamptz
  updated_by             String?      @db.Uuid
  version                Int          @default(1)

  @@map("expense_categories")
}

model Unit {
  id             String  @id @default(uuid(7)) @db.Uuid
  code           String  @unique @db.VarChar(10)
  name           String  @db.VarChar(30)
  base_unit_id   String? @db.Uuid
  factor_to_base Decimal @default(1) @db.Decimal(14, 6)

  @@map("units")
}

model InventoryItem {
  id                     String       @id @default(uuid(7)) @db.Uuid
  company_id             String       @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  code                   String       @db.VarChar(12)
  name_en                String       @db.VarChar(80)
  name_ta                String?      @db.VarChar(80)
  category               String       @db.VarChar(30)
  base_unit_id           String       @db.Uuid
  purchase_unit_id       String?      @db.Uuid
  is_perishable          Boolean      @default(false)
  daily_count_required   Boolean      @default(false)
  variance_threshold_pct Decimal?     @db.Decimal(7, 3)
  variance_threshold_qty Decimal?     @db.Decimal(14, 3)
  last_purchase_rate     Decimal?     @db.Decimal(14, 4)
  avg_cost               Decimal      @default(0) @db.Decimal(14, 4)
  status                 RecordStatus @default(ACTIVE)
  created_at             DateTime     @default(now()) @db.Timestamptz
  created_by             String?      @db.Uuid
  updated_at             DateTime     @updatedAt @db.Timestamptz
  updated_by             String?      @db.Uuid
  version                Int          @default(1)

  @@map("inventory_items")
}

model ItemLocationSetting {
  item_id     String   @db.Uuid
  location_id String   @db.Uuid
  min_stock   Decimal  @default(0) @db.Decimal(14, 3)
  reorder_qty Decimal? @db.Decimal(14, 3)
  is_stocked  Boolean  @default(true)

  @@id([item_id, location_id])
  @@map("item_location_settings")
}

model Supplier {
  id                   String       @id @default(uuid(7)) @db.Uuid
  company_id           String       @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  code                 String       @db.VarChar(10)
  name                 String       @db.VarChar(100)
  contact_person       String?      @db.VarChar(60)
  phone                String?      @db.VarChar(15)
  address              String?
  gstin                String?      @db.VarChar(15)
  payment_terms_days   Int          @default(0) @db.SmallInt
  opening_balance      Decimal      @default(0) @db.Decimal(14, 2)
  opening_balance_date DateTime?    @db.Date
  status               RecordStatus @default(ACTIVE)
  created_at           DateTime     @default(now()) @db.Timestamptz
  created_by           String?      @db.Uuid
  updated_at           DateTime     @updatedAt @db.Timestamptz
  updated_by           String?      @db.Uuid
  version              Int          @default(1)

  @@map("suppliers")
}

model SupplierItem {
  supplier_id String @db.Uuid
  item_id     String @db.Uuid

  @@id([supplier_id, item_id])
  @@map("supplier_items")
}

model Setting {
  company_id  String   @default(dbgenerated("(NULLIF(current_setting('app.company_id'::text, true), ''::text))::uuid")) @db.Uuid
  key         String   @db.VarChar(60)
  value       Json
  description String?
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz
  updated_by  String?  @db.Uuid

  @@id([company_id, key])
  @@map("settings")
}

// ---------------------------------------------------------------- daily operations
model DailySales {
  id                   String       @id @default(uuid(7)) @db.Uuid
  location_id          String       @db.Uuid
  business_date        DateTime     @db.Date
  total_sales          Decimal      @db.Decimal(14, 2)
  cash_sales           Decimal      @default(0) @db.Decimal(14, 2)
  upi_sales            Decimal      @default(0) @db.Decimal(14, 2)
  card_sales           Decimal      @default(0) @db.Decimal(14, 2)
  credit_sales         Decimal      @default(0) @db.Decimal(14, 2)
  complimentary_amount Decimal      @default(0) @db.Decimal(14, 2)
  other_adjustments    Decimal      @default(0) @db.Decimal(14, 2)
  mismatch_amount      Decimal      @default(0) @db.Decimal(14, 2)
  remarks              String?
  submitted_by         String       @db.Uuid
  submitted_at         DateTime     @db.Timestamptz
  is_locked            Boolean      @default(false)
  status               RecordStatus @default(ACTIVE)
  client_uuid          String?      @unique @db.Uuid
  client_created_at    DateTime?    @db.Timestamptz
  source               EntrySource  @default(WEB)
  created_at           DateTime     @default(now()) @db.Timestamptz
  created_by           String?      @db.Uuid
  updated_at           DateTime     @updatedAt @db.Timestamptz
  updated_by           String?      @db.Uuid
  version              Int          @default(1)

  // partial unique index (location_id, business_date) WHERE status='ACTIVE' is created in SQL migration
  @@index([location_id, business_date])
  @@map("daily_sales")
}

model CashTransaction {
  id             String       @id @default(uuid(7)) @db.Uuid
  location_id    String       @db.Uuid
  business_date  DateTime     @db.Date
  txn_type       CashTxnType
  direction      Int          @db.SmallInt // +1 in, -1 out
  amount         Decimal      @db.Decimal(14, 2)
  source_type    String?      @db.VarChar(30)
  source_id      String?      @db.Uuid
  description    String?
  status         RecordStatus @default(ACTIVE)
  reversal_of_id String?      @db.Uuid
  client_uuid    String?      @unique @db.Uuid
  source         EntrySource  @default(WEB)
  created_at     DateTime     @default(now()) @db.Timestamptz
  created_by     String?      @db.Uuid
  updated_at     DateTime     @updatedAt @db.Timestamptz
  updated_by     String?      @db.Uuid
  version        Int          @default(1)

  @@index([location_id, business_date])
  @@index([source_type, source_id])
  @@map("cash_transactions")
}

model CashReconciliation {
  id                  String          @id @default(uuid(7)) @db.Uuid
  location_id         String          @db.Uuid
  business_date       DateTime        @db.Date
  opening_cash        Decimal         @db.Decimal(14, 2)
  cash_sales          Decimal         @db.Decimal(14, 2)
  other_receipts      Decimal         @db.Decimal(14, 2)
  cash_expenses       Decimal         @db.Decimal(14, 2)
  cash_purchases      Decimal         @db.Decimal(14, 2)
  other_cash_out      Decimal         @db.Decimal(14, 2)
  withdrawals         Decimal         @db.Decimal(14, 2)
  expected_closing    Decimal         @db.Decimal(14, 2)
  actual_closing      Decimal?        @db.Decimal(14, 2)
  variance            Decimal?        @db.Decimal(14, 2)
  denomination_json   Json?
  variance_reason     String?         @db.VarChar(40)
  manager_explanation String?
  variance_approval   ApprovalStatus?
  approved_by         String?         @db.Uuid
  approved_at         DateTime?       @db.Timestamptz
  is_locked           Boolean         @default(false)
  created_at          DateTime        @default(now()) @db.Timestamptz
  created_by          String?         @db.Uuid
  updated_at          DateTime        @updatedAt @db.Timestamptz
  updated_by          String?         @db.Uuid
  version             Int             @default(1)

  @@unique([location_id, business_date])
  @@map("cash_reconciliation")
}

model DailyClosing {
  id                     String        @id @default(uuid(7)) @db.Uuid
  location_id            String        @db.Uuid
  business_date          DateTime      @db.Date
  status                 ClosingStatus @default(PENDING)
  daily_sales_id         String?       @db.Uuid
  cash_reconciliation_id String?       @db.Uuid
  total_sales            Decimal?      @db.Decimal(14, 2)
  cash_sales             Decimal?      @db.Decimal(14, 2)
  upi_sales              Decimal?      @db.Decimal(14, 2)
  card_sales             Decimal?      @db.Decimal(14, 2)
  total_expenses         Decimal?      @db.Decimal(14, 2)
  total_purchases        Decimal?      @db.Decimal(14, 2)
  total_wastage_value    Decimal?      @db.Decimal(14, 2)
  expected_cash          Decimal?      @db.Decimal(14, 2)
  actual_cash            Decimal?      @db.Decimal(14, 2)
  cash_variance          Decimal?      @db.Decimal(14, 2)
  stock_notes            String?
  remarks                String?
  submitted_by           String?       @db.Uuid
  submitted_at           DateTime?     @db.Timestamptz
  reviewed_by            String?       @db.Uuid
  reviewed_at            DateTime?     @db.Timestamptz
  review_comment         String?
  reopen_count           Int           @default(0) @db.SmallInt
  created_at             DateTime      @default(now()) @db.Timestamptz
  created_by             String?       @db.Uuid
  updated_at             DateTime      @updatedAt @db.Timestamptz
  updated_by             String?       @db.Uuid
  version                Int           @default(1)

  events DailyClosingEvent[]

  @@unique([location_id, business_date])
  @@index([status, business_date])
  @@map("daily_closing")
}

model DailyClosingEvent {
  id               String         @id @default(uuid(7)) @db.Uuid
  daily_closing_id String         @db.Uuid
  from_status      ClosingStatus?
  to_status        ClosingStatus
  actor_id         String         @db.Uuid
  comment          String?
  snapshot         Json?
  created_at       DateTime       @default(now()) @db.Timestamptz

  closing DailyClosing @relation(fields: [daily_closing_id], references: [id])

  @@map("daily_closing_events")
}

model Attendance {
  id             String           @id @default(uuid(7)) @db.Uuid
  employee_id    String           @db.Uuid
  location_id    String           @db.Uuid
  business_date  DateTime         @db.Date
  status         AttendanceStatus
  overtime_hours Decimal          @default(0) @db.Decimal(5, 2)
  check_in       DateTime?        @db.Time
  check_out      DateTime?        @db.Time
  remarks        String?
  marked_by      String           @db.Uuid
  client_uuid    String?          @unique @db.Uuid
  source         EntrySource      @default(WEB)
  created_at     DateTime         @default(now()) @db.Timestamptz
  created_by     String?          @db.Uuid
  updated_at     DateTime         @updatedAt @db.Timestamptz
  updated_by     String?          @db.Uuid
  version        Int              @default(1)

  @@unique([employee_id, business_date])
  @@index([location_id, business_date])
  @@map("attendance")
}

// ---------------------------------------------------------------- expenses, purchases, suppliers
model Expense {
  id                String         @id @default(uuid(7)) @db.Uuid
  code              String         @unique @db.VarChar(30)
  location_id       String         @db.Uuid
  business_date     DateTime       @db.Date
  category_id       String         @db.Uuid
  sub_category_id   String?        @db.Uuid
  amount            Decimal        @db.Decimal(14, 2)
  payment_mode      PaymentMode
  supplier_id       String?        @db.Uuid
  payee_name        String?        @db.VarChar(100)
  description       String?
  period_from       DateTime?      @db.Date
  period_to         DateTime?      @db.Date
  employee_id       String?        @db.Uuid
  approval_status   ApprovalStatus @default(SUBMITTED)
  approved_by       String?        @db.Uuid
  approved_at       DateTime?      @db.Timestamptz
  rejection_reason  String?
  entered_by        String         @db.Uuid
  status            RecordStatus   @default(ACTIVE)
  reversal_of_id    String?        @db.Uuid
  client_uuid       String?        @unique @db.Uuid
  client_created_at DateTime?      @db.Timestamptz
  source            EntrySource    @default(WEB)
  created_at        DateTime       @default(now()) @db.Timestamptz
  created_by        String?        @db.Uuid
  updated_at        DateTime       @updatedAt @db.Timestamptz
  updated_by        String?        @db.Uuid
  version           Int            @default(1)

  @@index([location_id, business_date])
  @@index([category_id, business_date])
  @@map("expenses")
}

model Purchase {
  id                String         @id @default(uuid(7)) @db.Uuid
  code              String         @unique @db.VarChar(30)
  location_id       String         @db.Uuid
  business_date     DateTime       @db.Date
  supplier_id       String         @db.Uuid
  supplier_ref_no   String?        @db.VarChar(40)
  subtotal          Decimal        @db.Decimal(14, 2)
  other_charges     Decimal        @default(0) @db.Decimal(14, 2)
  discount          Decimal        @default(0) @db.Decimal(14, 2)
  total_amount      Decimal        @db.Decimal(14, 2)
  payment_mode      PaymentMode
  paid_amount       Decimal        @default(0) @db.Decimal(14, 2)
  credit_amount     Decimal        @default(0) @db.Decimal(14, 2)
  due_date          DateTime?      @db.Date
  remarks           String?
  approval_status   ApprovalStatus @default(SUBMITTED)
  approved_by       String?        @db.Uuid
  approved_at       DateTime?      @db.Timestamptz
  rejection_reason  String?
  entered_by        String         @db.Uuid
  status            RecordStatus   @default(ACTIVE)
  reversal_of_id    String?        @db.Uuid
