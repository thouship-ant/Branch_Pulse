# App connection: non-owner role so PostgreSQL row-level security applies.
DATABASE_URL="postgresql://app_rw:app_rw@localhost:5432/branch_pulse?schema=public"
# Owner connection: used by `prisma migrate` and the seed script only.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/branch_pulse?schema=public"

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3300

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_MOBILE_HOURS=168
REFRESH_TTL_DESKTOP_HOURS=12
COOKIE_SECURE=false

# Local disk storage for attachments (dev). Replace with an S3-compatible provider in production.
UPLOAD_DIR=./uploads

# AES-256 key for employee bank details: 64 hex characters (openssl rand -hex 32). Required in production.
BANK_DETAILS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
