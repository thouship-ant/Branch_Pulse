# App connection: non-owner role so PostgreSQL row-level security applies.
DATABASE_URL="postgresql://app_rw:app_rw@localhost:5432/branch_pulse?schema=public"
# Owner connection: used by `prisma migrate` and the seed script only.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/branch_pulse?schema=public"

PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3300

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_MOBILE_HOURS=168
REFRESH_TTL_DESKTOP_HOURS=12
COOKIE_SECURE=false

# Local disk storage for attachments (dev). Replace with an S3-compatible provider in production.
UPLOAD_DIR=./uploads

# AES-256 key for employee bank details: 64 hex characters (openssl rand -hex 32). Required in production.
BANK_DETAILS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- OTP sign-in (mobile number + OTP) ----
# Development only: every OTP becomes this code and no SMS is sent. Leave EMPTY in production (the API refuses to
# start in production with it set).
OTP_FIXED_CODE=123456
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30

# SMS Fortius (DLT-registered OTP SMS). Without these the OTP is only printed in the API log.
SMS_FORTIUS_API_KEY=
SMS_FORTIUS_SENDER_ID=
SMS_FORTIUS_TEMPLATE_ID=
SMS_FORTIUS_BASE_URL=
# Must match the DLT-approved template text exactly; {otp} is replaced with the code.
SMS_OTP_TEMPLATE="Your Branch Pulse OTP is {otp}. Valid for 10 minutes. Do not share it."
