# API origin the app talks to (no trailing slash, no /api/v1). Defaults to the production API.
# Android emulator -> your PC:  http://10.0.2.2:4000    Real phone on Wi-Fi:  http://<your-pc-lan-ip>:4000
EXPO_PUBLIC_API_URL=https://api-branchpulse.antstockpulse.pro

# Where the full web version runs. In the browser build, the sign-in page then shows an "Open web version" link; unset = no link
# (in development it defaults to this host on port 3300).
# EXPO_PUBLIC_WEB_APP_URL=https://your-web-app.example.com
