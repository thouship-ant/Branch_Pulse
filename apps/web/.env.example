# Copy to `.env.local` (git-ignored) and restart `npm run dev:web` - Next reads env files at startup only.
#
# API_URL is where the web app's /api/* requests are proxied (see rewrites() in next.config.mjs).
#   unset + `next dev`            -> http://localhost:4000 (the local API)
#   unset + `next build` / start  -> https://api-branchpulse.antstockpulse.pro
# In a production build the target is fixed when `next build` runs, so set it before building.

# Local API (the default for `next dev`; only needed to make it explicit)
# API_URL=http://localhost:4000

# Point a local dev server at the production API (use with care: it is the real data)
# API_URL=https://api-branchpulse.antstockpulse.pro
