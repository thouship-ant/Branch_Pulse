# Copy to .env.prod on the server and fill in. Never commit .env.prod.
# Generate secrets with:  openssl rand -hex 24   (hex only: no characters that need URL-encoding)

# Public hostname (its DNS A record must point at this server). Caddy gets the HTTPS certificate for it.
DOMAIN=branchpulse.example.com

POSTGRES_PASSWORD=
APP_RW_PASSWORD=
JWT_ACCESS_SECRET=

# AES-256 key that encrypts employee bank details at rest: exactly 64 hex characters.  openssl rand -hex 32
# Keep a copy somewhere safe: if it is lost or changed, already-saved bank details cannot be read.
BANK_DETAILS_KEY=

# Password for the 'superadmin' login created by the seed (change it after the first sign-in).
SEED_PASSWORD=

# SMS Fortius: sends the sign-in OTP. Use the sender id and DLT template id registered for Branch Pulse; SMS_OTP_TEMPLATE
# must match the approved template text exactly ({otp} is replaced by the code). Leave OTP_FIXED_CODE unset in production.
SMS_FORTIUS_API_KEY=
SMS_FORTIUS_SENDER_ID=
SMS_FORTIUS_TEMPLATE_ID=
SMS_FORTIUS_BASE_URL=https://smsfortius.org/V2/apikey.php
SMS_OTP_TEMPLATE=Welcome to Branch Pulse! Your OTP for Branch Pulse is {otp}. Valid for 10 minutes. Please do not share it. - HfcWYr+rOk5
